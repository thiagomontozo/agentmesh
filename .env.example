AGENTMESH_ADDR=:8080
AGENTMESH_INSTANCE_ID=
AGENTMESH_MODE=memory
AGENTMESH_ROLE=all
AGENTMESH_WORKERS=4
AGENTMESH_QUEUE_SIZE=128
AGENTMESH_EXECUTION_DELAY=750ms
AGENTMESH_ATTEMPT_TIMEOUT=30s
AGENTMESH_SHUTDOWN_TIMEOUT=10s
AGENTMESH_MAX_ATTEMPTS=3
AGENTMESH_RETRY_INITIAL_BACKOFF=250ms
AGENTMESH_RETRY_MAX_BACKOFF=5s
AGENTMESH_NATS_ACK_WAIT=2m
AGENTMESH_CACHE_TTL=30s
AGENTMESH_LEASE_TTL=5m
AGENTMESH_EVENT_RETENTION=168h
AGENTMESH_EVENT_HISTORY_LIMIT=1000
AGENTMESH_AGENT_HEALTH_PATH=/healthz
AGENTMESH_AGENT_HEALTH_INTERVAL=30s
AGENTMESH_AGENT_HEALTH_TIMEOUT=2s
AGENTMESH_AGENT_HEALTH_WORKERS=2
AGENTMESH_WORKFLOW_LEASE_TTL=30s
AGENTMESH_HTTP_REQUIRE_HTTPS=false
AGENTMESH_HTTP_ALLOW_PRIVATE_NETWORKS=true
AGENTMESH_HTTP_ALLOW_LOOPBACK=true
AGENTMESH_HTTP_ALLOW_LINK_LOCAL=false
AGENTMESH_HTTP_ALLOWED_HOSTS=
AGENTMESH_HTTP_BLOCKED_CIDRS=
AGENTMESH_HTTP_MAX_REQUEST_BYTES=1048576
AGENTMESH_HTTP_MAX_RESPONSE_BYTES=1048576
# JSON maps Agent IDs to non-secret environment-variable references.
AGENTMESH_AGENT_AUTH_CONFIG=
AGENTMESH_API_AUTH_CONFIG=
AGENTMESH_AUDIT_RETENTION=2160h
AGENTMESH_AUDIT_MAX_EVENTS=100000
# Required when AGENTMESH_MODE=distributed:
AGENTMESH_DATABASE_URL=postgres://agentmesh:agentmesh@localhost:5432/agentmesh?sslmode=disable
AGENTMESH_NATS_URL=nats://localhost:4222
AGENTMESH_REDIS_URL=redis://localhost:6379/0
