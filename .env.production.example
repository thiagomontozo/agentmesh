COMPOSE_PROJECT_NAME=agentmesh-prod

# Mirror and pin every image in the on-premises registry. Digests are preferred.
AGENTMESH_IMAGE=registry.intra.example/agentmesh/backend:REPLACE_WITH_IMMUTABLE_TAG
DASHBOARD_IMAGE=registry.intra.example/agentmesh/dashboard:REPLACE_WITH_IMMUTABLE_TAG
POSTGRES_IMAGE=registry.intra.example/platform/postgres:17-alpine
NATS_IMAGE=registry.intra.example/platform/nats:2.12-alpine
REDIS_IMAGE=registry.intra.example/platform/redis:8.2-alpine
GATEWAY_IMAGE=registry.intra.example/platform/nginx:alpine
IMAGE_PULL_POLICY=always

SECRETS_DIR=./secrets/agentmesh
HTTP_BIND_ADDRESS=0.0.0.0
HTTPS_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

API_REPLICAS=2
WORKER_REPLICAS=2
AGENTMESH_WORKERS=4
AGENTMESH_ATTEMPT_TIMEOUT=2m
AGENTMESH_NATS_ACK_WAIT=3m
AGENTMESH_LEASE_TTL=5m
AGENTMESH_HTTP_REQUIRE_HTTPS=true
# Optional exact/wildcard Agent destination allowlist, for example *.agents.intra.example.
AGENTMESH_HTTP_ALLOWED_HOSTS=
AGENTMESH_HTTP_BLOCKED_CIDRS=

# JSON configuration only; never put credential values here.
AGENTMESH_AGENT_AUTH_CONFIG=
AGENTMESH_MCP_SERVERS=
OTEL_EXPORTER_OTLP_ENDPOINT=

POSTGRES_MEMORY=2g
POSTGRES_CPUS=2.0
POSTGRES_SHM_SIZE=256m
NATS_MEMORY=1g
NATS_CPUS=1.0
REDIS_MEMORY=1g
REDIS_CPUS=1.0
API_MEMORY=512m
API_CPUS=1.0
WORKER_MEMORY=1g
WORKER_CPUS=2.0
DASHBOARD_MEMORY=384m
DASHBOARD_CPUS=0.5
GATEWAY_MEMORY=256m
GATEWAY_CPUS=0.5
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
