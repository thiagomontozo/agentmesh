{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "config", "secrets", "api", "worker", "dashboard"],
  "properties": {
    "image": { "$ref": "#/definitions/image" },
    "config": {
      "type": "object",
      "required": ["workers", "attemptTimeout", "shutdownTimeout", "leaseTTL"],
      "properties": {
        "workers": { "type": "integer", "minimum": 1 },
        "attemptTimeout": { "type": "string", "minLength": 2 },
        "shutdownTimeout": { "type": "string", "minLength": 2 },
        "leaseTTL": { "type": "string", "minLength": 2 },
        "eventHistoryLimit": { "type": "integer", "minimum": 1 },
        "workflowConcurrency": { "type": "integer", "minimum": 1 }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret", "databaseURLKey", "natsURLKey", "redisURLKey"],
      "properties": {
        "existingSecret": { "type": "string" },
        "databaseURLKey": { "type": "string", "minLength": 1 },
        "natsURLKey": { "type": "string", "minLength": 1 },
        "redisURLKey": { "type": "string", "minLength": 1 }
      }
    },
    "api": { "$ref": "#/definitions/workload" },
    "worker": { "$ref": "#/definitions/workload" },
    "dashboard": {
      "type": "object",
      "required": ["enabled", "replicas", "image"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1 },
        "image": { "$ref": "#/definitions/image" }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "workload": {
      "type": "object",
      "required": ["replicas", "resources", "autoscaling", "pdb"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "resources": {
          "type": "object",
          "required": ["requests"],
          "properties": {
            "requests": {
              "type": "object",
              "required": ["cpu", "memory"]
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 },
            "targetMemoryUtilizationPercentage": { "type": ["integer", "null"], "minimum": 1, "maximum": 100 }
          }
        },
        "pdb": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": ["integer", "string"] }
          }
        }
      }
    }
  }
}
